{
  "manifest_version": 3,
  "name": "OPC-Agent",
  "version": "0.1.0",
  "description": "AI 团队指挥中心 — 选中文本一键交由 Agent 处理",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "notifications",
    "commands"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://*.opc-agent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "open-floating-window": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "打开浮动窗口"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
